                    odrl:operator odrl:eq ;
                    odrl:rightOperand dpv:CommunicationManagement ] ;
            odrl:target <http://example.org/datasets/climateChangeData> ],
        [ a odrl:Duty ;
            odrl:action [ odrl:refinement [ odrl:leftOperand odrl:hasFinishTime ;
                            odrl:operator odrl:gt ;
                            odrl:rightOperand "FFFF" ] ;
                    odrl:source <https://www.cactusweb.gr/vocab/Customer_Analysis> ] ;
            odrl:assignee [ a odrl:PartyCollection ;
                    odrl:refinement [ odrl:leftOperand odrl:actorEnhancedProperty2 ;
                            odrl:operator odrl:gt ;
                            odrl:rightOperand "CCC" ] ;
                    odrl:source dpv:Consumer ] ;
            odrl:constraint [ odrl:leftOperand odrl:purposeEnhancedProperty ;
                    odrl:operator odrl:hasPart ;
                    odrl:rightOperand "TTTT" ],
                [ odrl:leftOperand odrl:purpose ;
                    odrl:operator odrl:eq ;
                    odrl:rightOperand <https://www.cactusweb.gr/vocab/Benchmarking> ] ;
            odrl:target <http://example.org/datasets/climateChangeData> ] ;
    odrl:obligation [ a odrl:Obligation ;
            odrl:action dpv:Analyse ;
            odrl:assignee <https://www.cactusweb.gr/vocab/Cactus> ;
            odrl:constraint [ odrl:leftOperand odrl:purpose ;
                    odrl:operator odrl:eq ;
                    odrl:rightOperand dpv:CounterMoneyLaundering ] ;
            odrl:target <http://example.org/datasets/climateChangeData> ],
        [ a odrl:Obligation ;
            odrl:action <https://www.cactusweb.gr/vocab/Customer_Analysis> ;
            odrl:assignee <https://www.cactusweb.gr/vocab/Cactus> ;
            odrl:constraint [ odrl:leftOperand odrl:purpose ;
                    odrl:operator odrl:eq ;
                    odrl:rightOperand dpv:AccountManagement ] ;
            odrl:target <http://example.org/datasets/climateChangeData> ],
        [ a odrl:Obligation ;
            odrl:action odrl:sell ;
            odrl:assignee dpv:CharityOrganisation ;
            odrl:constraint [ odrl:leftOperand odrl:event ;
                    odrl:operator odrl:isAllOf ;
                    odrl:rightOperand "GGGG" ],
                [ odrl:leftOperand odrl:purpose ;
                    odrl:operator odrl:eq ;
