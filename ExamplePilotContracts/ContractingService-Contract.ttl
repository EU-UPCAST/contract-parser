            odrl:target <http://example.org/datasets/climateChangeData> ] ;
    odrl:permission [ a odrl:Permission ;
            odrl:action odrl:play ;
            odrl:assignee dpv:CharityOrganisation ;
            odrl:constraint [ odrl:leftOperand odrl:purpose ;
                    odrl:operator odrl:eq ;
                    odrl:rightOperand dpv:CommunicationForCustomerCare ] ;
            odrl:target <http://example.org/datasets/climateChangeData> ],
